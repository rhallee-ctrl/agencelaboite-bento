---
// Galerie d'images : titre a gauche + carrousel statique a droite
const image = "https://d22po4pjz3o32e.cloudfront.net/placeholder-image.svg";
const slides = [1, 2, 3, 4, 5, 6, 7];
---

<section class="overflow-hidden py-16 md:py-24 lg:py-28">
  <div
    class="grid auto-cols-fr grid-cols-1 items-center gap-12 md:gap-16 lg:grid-cols-2 lg:gap-0"
  >
    <div class="flex lg:justify-self-end">
      <div class="mx-[5%] w-full max-w-md lg:mb-24 lg:ml-[5vw] lg:mr-20">
        <h2 class="mb-5 text-5xl font-bold md:mb-6 md:text-7xl lg:text-8xl">
          Image Gallery
        </h2>
        <p class="md:text-md">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit.
        </p>
      </div>
    </div>
    <div
      class="relative overflow-hidden px-[5%] lg:px-0"
      role="region"
      aria-roledescription="carousel"
    >
      <div>
        <div class="flex ml-0">
          {
            slides.map((n) => (
              <div
                role="group"
                aria-roledescription="slide"
                class="min-w-0 shrink-0 grow-0 basis-[95%] pl-0 pr-6 sm:basis-4/5 md:basis-1/2 md:pr-8 lg:basis-4/5"
              >
                <div>
                  <img src={image} alt={`Relume placeholder image ${n}`} class="size-full object-cover" />
                </div>
              </div>
            ))
          }
        </div>
      </div>
      <div class="mt-12 flex items-center justify-between">
        <div class="flex gap-2 md:gap-4">
          <button
            class="focus-visible:ring-border-primary inline-flex gap-3 items-center justify-center whitespace-nowrap ring-offset-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-border-primary text-text-primary rounded-full bg-neutral-white static left-0 top-0 size-12 -translate-y-0"
            disabled
          >
            <svg
              stroke="currentColor"
              fill="currentColor"
              stroke-width="0"
              viewBox="0 0 24 24"
              class="size-6"
              height="1em"
              width="1em"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M12.707 17.293 8.414 13H18v-2H8.414l4.293-4.293-1.414-1.414L4.586 12l6.707 6.707z"
              ></path></svg
            ><span class="sr-only">Previous slide</span></button
          ><button
            class="focus-visible:ring-border-primary inline-flex gap-3 items-center justify-center whitespace-nowrap ring-offset-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-border-primary text-text-primary rounded-full bg-neutral-white right-0 static left-0 top-0 size-12 -translate-y-0"
            disabled
          >
            <svg
              stroke="currentColor"
              fill="currentColor"
              stroke-width="0"
              viewBox="0 0 24 24"
              class="size-6"
              height="1em"
              width="1em"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z"
              ></path></svg
            ><span class="sr-only">Next slide</span>
          </button>
        </div>
        <div
          class="absolute right-[5%] mt-5 flex items-center justify-end md:right-8 lg:right-16"
        >
          {
            slides.map(() => (
              <button class="mx-[3px] inline-block size-2 rounded-full bg-neutral-light" />
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
