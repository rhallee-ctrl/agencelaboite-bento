---
// Section portfolio : grille de projets en colonnes (effet "masonry")
const landscape =
  "https://d22po4pjz3o32e.cloudfront.net/placeholder-image-landscape.svg";
const square = "https://d22po4pjz3o32e.cloudfront.net/placeholder-image.svg";

// Les 6 cartes de projet (la 3e utilise une image carree, comme dans Relume)
const projects = [landscape, landscape, square, landscape, landscape, landscape];
---

<section class="px-[5%] py-16 md:py-24 lg:py-28">
  <div class="container">
    <header class="mx-auto mb-12 max-w-lg text-center md:mb-18 lg:mb-20">
      <p class="mb-3 font-semibold md:mb-4">Portfolio</p>
      <h2 class="mb-5 text-5xl font-bold md:mb-6 md:text-7xl lg:text-8xl">
        Short heading goes here
      </h2>
      <p class="md:text-md">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit.
      </p>
    </header>
    <div class="columns-1 after:block md:columns-2 md:gap-x-8 lg:columns-3">
      {
        projects.map((src) => (
          <article class="mb-8 break-inside-avoid">
            <div class="mb-5 md:mb-6">
              <a href="#">
                <img src={src} class="w-full object-cover" alt="Relume placeholder image" />
              </a>
            </div>
            <h3 class="mb-2 text-xl font-bold md:text-2xl">
              <a href="#">Project name here</a>
            </h3>
            <p>
              Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse
              varius enim in eros.
            </p>
            <ul class="mt-3 flex flex-wrap gap-2 md:mt-4">
              <li class="flex">
                <a href="#" class="bg-background-secondary px-2 py-1 text-sm font-semibold">
                  Tag one
                </a>
              </li>
              <li class="flex">
                <a href="#" class="bg-background-secondary px-2 py-1 text-sm font-semibold">
                  Tag two
                </a>
              </li>
              <li class="flex">
                <a href="#" class="bg-background-secondary px-2 py-1 text-sm font-semibold">
                  Tag three
                </a>
              </li>
            </ul>
            <button
              class="focus-visible:ring-border-primary inline-flex items-center justify-center whitespace-nowrap ring-offset-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border-0 text-text-primary gap-2 p-0 mt-5 md:mt-6"
              title="View project"
            >
              <a href="#">View project</a>
              <svg
                stroke="currentColor"
                fill="none"
                stroke-width="0"
                viewBox="0 0 15 15"
                height="1em"
                width="1em"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  fill-rule="evenodd"
                  clip-rule="evenodd"
                  d="M6.1584 3.13508C6.35985 2.94621 6.67627 2.95642 6.86514 3.15788L10.6151 7.15788C10.7954 7.3502 10.7954 7.64949 10.6151 7.84182L6.86514 11.8418C6.67627 12.0433 6.35985 12.0535 6.1584 11.8646C5.95694 11.6757 5.94673 11.3593 6.1356 11.1579L9.565 7.49985L6.1356 3.84182C5.94673 3.64036 5.95694 3.32394 6.1584 3.13508Z"
                  fill="currentColor"
                />
              </svg>
            </button>
          </article>
        ))
      }
    </div>
    <footer class="mt-8 flex justify-center md:mt-18 lg:mt-20">
      <button
        class="focus-visible:ring-border-primary inline-flex gap-3 items-center justify-center whitespace-nowrap ring-offset-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-border-primary text-text-primary bg-background-primary px-6 py-3"
        title="View all"
      >
        View all
      </button>
    </footer>
  </div>
</section>
