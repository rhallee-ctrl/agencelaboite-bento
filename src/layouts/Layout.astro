---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "La Boite Image" } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />

    <!-- GSAP : animation au defilement (chargee depuis le CDN sur le site en ligne) -->
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.15.0/gsap.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.15.0/ScrollTrigger.min.js"></script>
    <script is:inline>
      // Hero : les images du collage grossissent et se deplacent au scroll
      window.addEventListener("load", function () {
        if (!window.gsap || !window.ScrollTrigger) return;
        gsap.registerPlugin(ScrollTrigger);
        var imgs = gsap.utils.toArray("#hero-collage img");
        if (!imgs.length) return;
        imgs.forEach(function (img, i) {
          var dirX = (i % 3) - 1; // -1, 0 ou 1 selon l'image
          var dirY = i % 2 === 0 ? -1 : 1; // une image sur deux monte / descend
          gsap.fromTo(
            img,
            { scale: 1, xPercent: 0, yPercent: 0 },
            {
              scale: 1.6,
              xPercent: dirX * 45,
              yPercent: dirY * 65,
              ease: "none",
              scrollTrigger: {
                trigger: "#hero",
                start: "top top",
                end: "bottom top",
                scrub: true,
              },
            }
          );
        });
      });
    </script>
  </body>
</html>
